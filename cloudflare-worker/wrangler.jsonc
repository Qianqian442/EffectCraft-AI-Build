{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ae-cloud-account-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ae-accounts",

# Copy this file to .env and replace both secrets before starting.
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
ADMIN_USERNAME=admin
# setup.ps1 generates ADMIN_PASSWORD_HASH automatically; do not enter a plain password here.
ADMIN_PASSWORD_HASH=pbkdf2-sha256:310000:BASE64_SALT:BASE64_HASH
